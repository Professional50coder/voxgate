# VoxGate web (apps/web) env template. Copy to .env.local for local dev;
# on Vercel, set these as Project Environment Variables instead.

# Where the FastAPI backend lives. This is read SERVER-SIDE at start by
# next.config.ts and used to rewrite /api/* to the backend, so the browser
# only ever talks to this same origin (no CORS). In dev keep the default if
# you run uvicorn on :8000:
#   API_ORIGIN=http://127.0.0.1:8000
# On Vercel point it at the deployed backend, e.g.:
#   API_ORIGIN=https://voxgate-e1j8.vercel.app
API_ORIGIN=http://127.0.0.1:8000

# Canonical site URL used by metadata / sitemap / OpenGraph. Overrides the
# "https://voxgate.app" default.
#   NEXT_PUBLIC_SITE_URL=https://your-frontend.vercel.app

# Optional escape hatch: if this frontend is served by something that cannot
# rewrite /api/* (e.g. a plain static CDN), set it to the backend's public URL.
# This reintroduces cross-origin requests, so the backend's
# VOXGATE_CORS_ORIGINS must then list this frontend's origin. Do NOT set it
# when using the default same-origin rewrite path.
#   NEXT_PUBLIC_API_URL=https://voxgate-e1j8.vercel.app