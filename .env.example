# VoxGate runtime configuration.

# Leave VOXGATE_DATABASE_URL unset (or commented) for in-memory dev mode (no persistence).
# Set to a Postgres DSN to persist LangGraph case checkpoints (run `docker compose up -d` first).
#VOXGATE_DATABASE_URL=postgresql://voxgate:voxgate@localhost:5433/voxgate

# Override where scenario packs are loaded from (defaults to <repo_root>/packs).
#VOXGATE_PACKS_DIR=

# Context.dev brand / web-scraping API key (opt-in enrichment; leave unset to disable).
# Get a key at https://context.dev/dashboard (starts with ctxt_secret_). SDKs read CONTEXT_DEV_API_KEY.
#CONTEXT_DEV_API_KEY=ctxt_secret_

# Groq (free-tier) LLM "brain": interprets spoken answers into canonical field
# values and, later, serves as the Pipecat LLM stage. OpenAI-compatible at
# https://api.groq.com/openai/v1. Leave unset to fall back to the raw transcript.
#GROQ_API_KEY=gsk_

# Cartesia (natural Sonic voice) TTS for the Pipecat voice agent.
# Get a key at https://cartesia.ai (starts with sk_car_). Leave unset to skip TTS.
#CARTESIA_API_KEY=sk_car_