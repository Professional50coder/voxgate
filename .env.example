# VoxGate environment template. Copy to `.env` and fill in real values.
# `.env` is gitignored; this file is not. Never put a real secret here.

# --- Database -------------------------------------------------------------
# Leave unset for in-memory dev mode (no persistence).
VOXGATE_DATABASE_URL=postgresql://voxgate:voxgate@localhost:5433/voxgate

# --- Groq (free-tier hosted inference) -----------------------------------
# Get a key at https://console.groq.com/keys
# The `groq` SDK reads this automatically: `client = Groq()` needs no argument.
GROQ_API_KEY=gsk_replace_me
GROQ_MODEL=openai/gpt-oss-120b
# Optional pool. Comma separated. Limits are per key AND per model, so more
# keys means proportionally more headroom.
GROQ_API_KEYS=gsk_replace_me,gsk_replace_me_too

# --- Cartesia (the agents' voice) ----------------------------------------
# Get a key at https://play.cartesia.ai. Unset means the browser and the voice
# worker use their local voices; nothing else changes. Each pack's agent picks
# its own primary and fallback voice in pack.yaml.
CARTESIA_API_KEY=replace_me
CARTESIA_MODEL=sonic-3

# --- Transcripts ----------------------------------------------------------
# Where per-session interview transcripts are written. Defaults to
# <repo>/transcripts locally and /tmp/voxgate-transcripts on Vercel, where it
# is ephemeral, so point it at durable storage if transcripts must be kept.
#   VOXGATE_TRANSCRIPTS_DIR=/var/lib/voxgate/transcripts

# --- Exa (web search / research) -----------------------------------------
# Get a key at https://dashboard.exa.ai
EXA_API_KEY=replace_me

# ===========================================================================
# DEPLOYMENT
#
# Everything above works on localhost with no changes. Everything below MUST
# be set when hosting on a real domain, or the app will look broken in ways
# that do not resemble their cause.
# ===========================================================================

# Browser origins allowed to call the API. Comma separated, exact match on
# scheme AND port. Miss this and the browser blocks every request while curl
# still works, which reads as "the backend is down".
#   VOXGATE_CORS_ORIGINS=https://app.yourdomain.com

# Real Postgres. The docker-compose one is localhost only.
#   VOXGATE_DATABASE_URL=postgresql://user:pass@db.yourhost:5432/voxgate

# --- Frontend (apps/web/.env.local, NOT this file) -------------------------
# These are baked in at BUILD time, not read at runtime, so setting them after
# a build has no effect. Rebuild after changing either.
#
#   NEXT_PUBLIC_API_URL=https://api.yourdomain.com
#   NEXT_PUBLIC_SITE_URL=https://app.yourdomain.com
#
# NEXT_PUBLIC_API_URL defaults to http://127.0.0.1:8000. A deployed frontend
# left on that default calls the visitor's own machine and fails silently.
# NEXT_PUBLIC_SITE_URL defaults to https://voxgate.app and feeds sitemap.xml,
# robots.txt and the OG card, so a wrong value publishes wrong canonical URLs.
